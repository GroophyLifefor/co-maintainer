{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "main.ts",
    "mod.ts",
    "src/**/*.ts",
    "scripts/**/*.ts",
    "benchmark/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "docs",
    "benchmark/**/clones",
    "benchmark/**/dataset",
    "benchmark/**/results"
  ]
}
