{
  "name": "@murat/co-maintainer",
  "version": "0.1.5",
  "license": "MIT",
  "exports": "./mod.ts",
  "imports": {
    "@db/sqlite": "jsr:@db/sqlite@^0.13.0"
  },
  "tasks": {
    "dev": "deno run --allow-all --watch main.ts",
    "probe": "deno run --allow-all main.ts probe",
    "init": "deno run --allow-all main.ts init",
    "remake": "deno run --allow-all main.ts remake",
    "review": "deno run --allow-all main.ts review",
    "bench": "deno run --allow-all benchmark/run.ts",
    "bench-v2": "deno run --allow-all benchmark/run_v2.ts",
    "check": "deno check main.ts",
    "fmt": "deno fmt",
    "test": "deno test --allow-all"
  }
}
